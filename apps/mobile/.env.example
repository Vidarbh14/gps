# Copy to .env.local (git-ignored). Restart `npx expo start --clear` after changes.

# mock = in-app simulator, no backend; live = Siddhant's Socket.io/REST server
EXPO_PUBLIC_DATA_SOURCE=mock
# Use your computer's LAN IP, not localhost — the phone can't reach your PC's localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Dispatcher web (for the Google road-route proxy at /api/road-route). Android only.
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:3000

# Only needed for development/store builds (Expo Go has its own key). Restrict to Maps SDK for Android.
GOOGLE_MAPS_ANDROID_API_KEY=
